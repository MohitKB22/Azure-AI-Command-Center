# Azure AI Command Center — example configuration.
# Copy to .env and adjust. Never commit a real .env file.

# ---------------------------------------------------------------- application
ENVIRONMENT=local              # local | dev | staging | production
DEBUG=false
DEMO_MODE=true                 # seeds and labels synthetic data; must be false in production

# ------------------------------------------------------------------- security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-key-change-me
ACCESS_TOKEN_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=240
MAX_UPLOAD_BYTES=20971520

# -------------------------------------------------------------------- storage
# Local development uses SQLite. Docker Compose and production use PostgreSQL.
DATABASE_URL=sqlite:///./azure_ai_command_center.db
# DATABASE_URL=postgresql+psycopg://aicc:aicc@postgres:5432/aicc

# ---------------------------------------------------------- provider selection
# "local" runs deterministic in-process implementations — no Azure account needed.
LLM_PROVIDER=local             # local | azure
EMBEDDING_PROVIDER=local       # local | azure
VECTOR_STORE=local             # local | qdrant
BLOB_PROVIDER=local            # local | azure
LOCAL_BLOB_DIR=./var/blobs

# ---------------------------------------------------------------------- azure
# Only read when the matching provider above is set to "azure".
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# AZURE_USE_MANAGED_IDENTITY=false        # preferred over API keys in Azure
# AZURE_SEARCH_ENDPOINT=
# AZURE_SEARCH_API_KEY=
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=documents
# AZURE_KEYVAULT_URL=https://<vault>.vault.azure.net
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# --------------------------------------------------------------------- qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=aicc_chunks

# ------------------------------------------------------------------------ rag
EMBEDDING_DIM=768
DEFAULT_CHUNK_SIZE=900
DEFAULT_CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.05

# ------------------------------------------------------------------- frontend
VITE_API_BASE_URL=http://localhost:8000
